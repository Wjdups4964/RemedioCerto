<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_titulo" />

        <!-- 1. Dados do medicamento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cadastro_nome">

                    <!-- Campo com lista de sugestões. O style deixa o tamanho igual ao dos outros campos. -->
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etNome"
                        style="?attr/editTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="2"
                        android:inputType="textCapWords|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cadastro_dose"
                    app:helperText="@string/cadastro_dose_ajuda">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cadastro_forma_titulo"
                    android:textSize="@dimen/texto_corpo" />

                <!-- Toque para escolher; tocar de novo desmarca (a forma é opcional). -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsForma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:selectionRequired="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaComprimido"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_comprimido"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaCapsula"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_capsula"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaGotas"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_gotas"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaXarope"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_xarope"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaInjecao"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_injecao"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaPomada"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_pomada"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormaOutro"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_outro"
                        android:textSize="18sp" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cadastro_observacoes">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etObservacoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Quando tomar, dentro do dia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    android:id="@+id/tvHorariosTitulo"
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cadastro_quando" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cadastro_quando_ajuda"
                    android:textColor="@color/rc_texto_suave"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleModo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="true"
                    android:orientation="vertical"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModoFixos"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_modo_fixos" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModoIntervalo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_modo_intervalo" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Modo: horários fixos -->
                <LinearLayout
                    android:id="@+id/layoutFixos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cadastro_fixos_ajuda"
                        android:textSize="@dimen/texto_corpo" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/cadastro_horario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHorario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Horários já escolhidos: toque no x para remover -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsHorarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Modo: de X em X horas -->
                <LinearLayout
                    android:id="@+id/layoutIntervalo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cadastro_intervalo_titulo"
                        android:textSize="@dimen/texto_corpo" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsIntervalo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip2h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intervalo_2h"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip3h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intervalo_3h"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip4h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intervalo_4h"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip6h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intervalo_6h"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip8h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/intervalo_8h"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip12h"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intervalo_12h"
                            android:textSize="18sp" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/cadastro_primeira_dose">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPrimeiraDose"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvPrevia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_destaque"
                        android:padding="12dp"
                        android:textColor="@color/rc_primaria_escura"
                        android:textSize="@dimen/texto_corpo"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Em quais dias -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cadastro_dias_titulo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cadastro_dias_ajuda"
                    android:textSize="@dimen/texto_corpo" />

                <RadioGroup
                    android:id="@+id/rgDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbTodoDia">

                    <RadioButton
                        android:id="@+id/rbTodoDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_dias_todo_dia"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rbACadaDias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_dias_a_cada"
                        android:textSize="@dimen/texto_corpo" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIntervaloDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cadastro_dias_quantos"
                    app:helperText="@string/cadastro_dias_quantos_ajuda"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIntervaloDias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvDiasPrevia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/rc_primaria_escura"
                    android:textSize="@dimen/texto_corpo"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Período do tratamento: início e previsão de término -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cadastro_periodo_titulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cadastro_periodo_inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <RadioGroup
                    android:id="@+id/rgDuracao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkedButton="@+id/rbContinuo">

                    <RadioButton
                        android:id="@+id/rbContinuo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_periodo_continuo"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rbPorDias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_periodo_com_fim"
                        android:textSize="@dimen/texto_corpo" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTermino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cadastro_periodo_termino"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTermino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvPeriodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_destaque"
                    android:padding="@dimen/margem"
                    android:textColor="@color/rc_primaria_escura"
                    android:textSize="@dimen/texto_corpo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Adiamento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cadastro_adiamento" />

                <RadioGroup
                    android:id="@+id/rgAdiamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rb10">

                    <RadioButton
                        android:id="@+id/rb5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_5min"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rb10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_10min"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rb15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/cadastro_15min"
                        android:textSize="@dimen/texto_corpo" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/cadastro_salvar" />
    </LinearLayout>
</ScrollView>
