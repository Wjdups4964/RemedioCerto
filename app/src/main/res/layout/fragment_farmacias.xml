<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margem">

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/Estilo.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/farmacias_titulo" />

    <TextView
        android:id="@+id/tvTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:text="@string/farmacias_texto"
        android:textSize="@dimen/texto_corpo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAbrirMapas"
        style="@style/Widget.RemedioCerto.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:minHeight="@dimen/altura_botao"
        android:text="@string/farmacias_botao" />

    <TextView
        android:id="@+id/tvDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:text="@string/farmacias_dica"
        android:textSize="16sp" />
</LinearLayout>
