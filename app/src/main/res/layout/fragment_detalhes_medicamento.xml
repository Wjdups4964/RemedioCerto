<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detalhes_titulo" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_primaria_escura"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Losartana" />

                <TextView
                    android:id="@+id/tvDoseHorarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/rc_texto"
                    android:textSize="@dimen/texto_corpo"
                    tools:text="Dose: 50 mg\nHorários: 08:00, 20:00\nDias: Todos os dias\nPeríodo: Uso contínuo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detalhes_bula_titulo" />

                <TextView
                    android:id="@+id/tvInfoBula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/detalhes_bula_inicial"
                    android:textSize="@dimen/texto_corpo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulaOficial"
            style="@style/Widget.RemedioCerto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:minHeight="@dimen/altura_botao"
            android:text="@string/bula_link_oficial"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultarBula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/detalhes_consultar_bula" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            style="@style/Widget.RemedioCerto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao"
            android:layout_marginTop="8dp"
            android:text="@string/detalhes_editar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApagar"
            style="@style/Widget.RemedioCerto.Button.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao"
            android:layout_marginTop="8dp"
            android:text="@string/detalhes_apagar"
            android:textColor="@color/rc_perdida" />

        <TextView
            android:id="@+id/tvAvisoMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/aviso_medico"
            android:textColor="@color/rc_texto_suave"
            android:textSize="@dimen/texto_corpo" />
    </LinearLayout>
</ScrollView>
