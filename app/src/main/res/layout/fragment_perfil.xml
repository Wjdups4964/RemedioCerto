<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perfil_titulo" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:textColor="@color/rc_texto_suave"
            android:textSize="@dimen/texto_corpo"
            tools:text="Conta: maria@email.com" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/perfil_nome">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/perfil_nascimento">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNascimento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvIdade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/rc_primaria_escura"
                    android:textSize="@dimen/texto_corpo"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Idade: 72 anos"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_sexo" />

                <RadioGroup
                    android:id="@+id/rgSexo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbNaoInformar">

                    <RadioButton
                        android:id="@+id/rbFeminino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/sexo_feminino"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rbMasculino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/sexo_masculino"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rbOutro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/sexo_outro"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioButton
                        android:id="@+id/rbNaoInformar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/altura_botao"
                        android:text="@string/sexo_nao_informar"
                        android:textSize="@dimen/texto_corpo" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/perfil_contato">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/perfil_salvar" />
    </LinearLayout>
</ScrollView>
