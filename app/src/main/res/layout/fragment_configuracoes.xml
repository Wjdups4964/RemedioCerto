<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_titulo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPerfil"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/config_perfil" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAcessibilidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/altura_botao"
                android:padding="@dimen/margem"
                android:text="@string/config_acessibilidade"
                android:textSize="@dimen/texto_corpo" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_tema" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaAutomatico"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/altura_botao"
                        android:layout_weight="1"
                        android:text="@string/tema_automatico"
                        android:textSize="@dimen/texto_corpo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaClaro"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/altura_botao"
                        android:layout_weight="1"
                        android:text="@string/tema_claro"
                        android:textSize="@dimen/texto_corpo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaEscuro"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/altura_botao"
                        android:layout_weight="1"
                        android:text="@string/tema_escuro"
                        android:textSize="@dimen/texto_corpo" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVinculo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/config_vinculo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFarmacias"
            style="@style/Widget.RemedioCerto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="8dp"
            android:text="@string/config_farmacias" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSair"
            style="@style/Widget.RemedioCerto.Button.Texto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="8dp"
            android:text="@string/config_sair" />
    </LinearLayout>
</ScrollView>
