<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarme"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/margem">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarme_emoji"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarme_titulo"
        android:textColor="@color/rc_sobre_gradiente_suave"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNomeMedicamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_alarme"
        android:textStyle="bold"
        tools:text="Losartana" />

    <TextView
        android:id="@+id/tvDose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_titulo"
        tools:text="50 mg · 1 comprimido" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTomei"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_botao_alarme"
        android:layout_marginTop="48dp"
        android:text="@string/alarme_tomei"
        android:textColor="@color/rc_gradiente_inicio"
        android:textSize="@dimen/texto_alarme"
        app:backgroundTint="@color/white"
        app:cornerRadius="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdiar"
        style="@style/Widget.RemedioCerto.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_botao_alarme"
        android:layout_marginTop="@dimen/margem"
        android:text="@string/alarme_adiar"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_alarme"
        app:cornerRadius="48dp"
        app:strokeColor="@color/white" />
</LinearLayout>
