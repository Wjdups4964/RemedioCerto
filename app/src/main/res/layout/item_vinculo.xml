<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/altura_botao"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvNomeFamiliar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/texto_corpo"
            android:textStyle="bold"
            tools:text="Maria (filha)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRevogar"
            style="@style/Widget.RemedioCerto.Button.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vinculo_revogar"
            android:textColor="@color/rc_perdida" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
