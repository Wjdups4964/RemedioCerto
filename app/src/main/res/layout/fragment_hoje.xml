<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margem">

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/Estilo.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hoje_titulo" />

    <!-- Só aparece quando falta permissão para os avisos (notificações desligadas ou alarmes exatos) -->
    <LinearLayout
        android:id="@+id/layoutAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:background="@drawable/bg_destaque"
        android:orientation="vertical"
        android:padding="@dimen/margem"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rc_primaria_escura"
            android:textSize="@dimen/texto_corpo"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="@dimen/altura_botao" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDoses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margem"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/margem"
        android:text="@string/hoje_vazio"
        android:textColor="@color/rc_texto_suave"
        android:textSize="@dimen/texto_corpo"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProximosDias"
        style="@style/Widget.RemedioCerto.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem"
        android:minHeight="@dimen/altura_botao"
        android:text="@string/proximos_botao" />
</LinearLayout>
