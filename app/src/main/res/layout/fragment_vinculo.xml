<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vinculo_titulo" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vinculo_gerar_titulo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGerarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/altura_botao"
                    android:layout_marginTop="8dp"
                    android:text="@string/vinculo_gerar" />

                <TextView
                    android:id="@+id/tvCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_destaque"
                    android:gravity="center"
                    android:padding="@dimen/margem"
                    android:text="@string/vinculo_codigo_vazio"
                    android:textColor="@color/rc_primaria_escura"
                    android:textSize="@dimen/texto_alarme"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    style="@style/Estilo.Secao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vinculo_usar_titulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vinculo_codigo_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodigoConvite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVincular"
                    style="@style/Widget.RemedioCerto.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/altura_botao"
                    android:layout_marginTop="8dp"
                    android:text="@string/vinculo_vincular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Estilo.Secao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem"
            android:text="@string/vinculo_lista_titulo" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVinculos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
