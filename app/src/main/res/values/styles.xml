<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Formas -->
    <style name="Forma.Pequena" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Forma.Media" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="Forma.Grande" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Cartões: fundo branco com sombra suave -->
    <style name="Widget.RemedioCerto.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/rc_superficie</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">22dp</item>
    </style>

    <!-- Botões -->
    <style name="Widget.RemedioCerto.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.RemedioCerto.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/rc_primaria_escura</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/rc_primaria</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.RemedioCerto.Button.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Botão flutuante em coral, para chamar a atenção -->
    <style name="Widget.RemedioCerto.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/rc_coral</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Barra de abas -->
    <style name="Widget.RemedioCerto.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">12dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/Texto.Aba</item>
        <item name="itemTextAppearanceInactive">@style/Texto.Aba</item>
    </style>

    <style name="Texto.Aba" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Título de cada tela: faixa colorida com degradê -->
    <style name="Estilo.Titulo" parent="">
        <item name="android:background">@drawable/bg_cabecalho</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">20dp</item>
        <!-- Espaço à direita para o botão de voltar não cobrir o texto -->
        <item name="android:paddingEnd">76dp</item>
    </style>

    <!-- Subtítulo de seção dentro das telas -->
    <style name="Estilo.Secao" parent="">
        <item name="android:textColor">@color/rc_primaria_escura</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Etiqueta arredondada, usada para a situação da dose -->
    <style name="Estilo.Pilula" parent="">
        <item name="android:background">@drawable/bg_pilula</item>
        <item name="android:textColor">@color/rc_primaria_escura</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
